:80 {
	root * /srv
	encode gzip

	# Публичным остаётся только маршрут с серверной проверкой Telegram initData.
	@public_requisition {
		method POST
		path /api/requisitions/public
	}
	handle @public_requisition {
		reverse_proxy backend:8000
	}

	# Неизвестные API-маршруты не должны попадать в SPA или доверенный proxy.
	handle /api/* {
		respond "Not Found" 404
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
