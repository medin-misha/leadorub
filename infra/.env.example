# ============================================================================
# Leadorub — единый файл окружения для всей инфраструктуры и сервисов.
# Compose читает .env из текущей директории, поэтому запускай команды из infra/
# либо передавай --env-file infra/.env (см. infra/README.md).
#
# Важно: креды дублируются в двух видах —
#   1) как параметры самих сервисов (POSTGRES_PASSWORD и т.п.);
#   2) как строки подключения приложений (database_url и т.п.), где ХОСТ =
#      имя docker-сервиса (postgres, redis, rabbitmq, minio, mongo).
# Значения в обоих местах должны совпадать.
# ============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
POSTGRES_USER=leadorub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leadorub

# ----------------------------------------------------------------------------
# RabbitMQ
# ----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=leadorub
RABBITMQ_DEFAULT_PASS=change-me

# ----------------------------------------------------------------------------
# Redis (в dev без пароля; для прода задай пароль и поправь redis_url)
# ----------------------------------------------------------------------------
# REDIS_PASSWORD=

# ----------------------------------------------------------------------------
# MongoDB (хранилище модуля чата/сообщений)
# ----------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=leadorub
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=leadorub

# ----------------------------------------------------------------------------
# MinIO (S3-хранилище для file_module)
# MINIO_ROOT_PASSWORD должен быть не короче 8 символов.
# ----------------------------------------------------------------------------
MINIO_ROOT_USER=leadorub
MINIO_ROOT_PASSWORD=change-me-min8
MINIO_BUCKET=leadorub

# ----------------------------------------------------------------------------
# Grafana (мониторинг логов через Loki)
# ----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ============================================================================
# Backend (apps/backend) — строки подключения внутри docker-сети.
# Имена переменных строго совпадают с app/core/config.py (case-sensitive).
# ============================================================================
debug=true
cors_origins=*

# PostgreSQL (asyncpg)
database_url=postgresql+asyncpg://leadorub:change-me@postgres:5432/leadorub
database_pool_size=5
database_max_overflow=10
database_pool_timeout=30
database_pool_recycle=1800

# RabbitMQ (aio-pika)
amqp_url=amqp://leadorub:change-me@rabbitmq:5672/
rabbitmq_enabled=true
rabbitmq_default_exchange=app.events
rabbitmq_default_exchange_type=direct
rabbitmq_default_queue=app.events.default
rabbitmq_default_routing_key=app.events.default
rabbitmq_prefetch_count=10
rabbitmq_consumer_enabled=true
rabbitmq_publish_timeout=5
rabbitmq_reconnect_interval=5
rabbitmq_debug_endpoints_enabled=false

# MinIO / S3
minio_endpoint=minio:9000
minio_access_key=leadorub
minio_secret_key=change-me-min8
minio_bucket=leadorub
minio_secure=false

# Taskiq (RabbitMQ + Redis)
taskiq_enabled=false
redis_url=redis://redis:6379/0
taskiq_schedule_prefix=schedule
taskiq_debug_endpoints_enabled=false

# MongoDB connection string (для будущего модуля чата)
mongo_url=mongodb://leadorub:change-me@mongo:27017/leadorub?authSource=admin

# ============================================================================
# Telegram-боты (apps/tg_user_bot, apps/tg_admin_bot)
# Один токен на бота; в apps-compose маппится в переменную TOKEN сервиса.
# ============================================================================
user_bot=
admin_bot=
